# Set default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.h text
*.js text
*.ts text
*.jsx text
*.tsx text
*.json text
*.css text
*.html text
*.md text
*.yaml text
*.yml text
*.toml text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.gguf binary
*.onnx binary
*.sqlite binary
*.db binary

# IMPORTANT: Force shell scripts to always have LF line endings.
# If these have CRLF, Docker builds and execution inside Linux containers will fail.
*.sh text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf

# Force python files to lf can be good for linux docker compatibility
*.py text eol=lf
*.conf text eol=lf
