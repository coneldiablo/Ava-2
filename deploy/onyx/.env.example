IMAGE_TAG=v4.7.0
WEB_DOMAIN=https://onyx.example.com
SESSION_EXPIRE_TIME_SECONDS=604800

POSTGRES_USER=onyx
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
DB_READONLY_USER=onyx_readonly
DB_READONLY_PASSWORD=replace-with-openssl-rand-hex-32

OPENSEARCH_ADMIN_PASSWORD=replace-with-openssl-rand-base64-32

S3_ENDPOINT_URL=http://minio:9000
S3_AWS_ACCESS_KEY_ID=replace-with-openssl-rand-hex-24
S3_AWS_SECRET_ACCESS_KEY=replace-with-openssl-rand-base64-32
S3_FILE_STORE_BUCKET_NAME=onyx-file-store
MINIO_ROOT_USER=replace-with-openssl-rand-hex-24
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-base64-32

SHOW_EXTRA_CONNECTORS=false
USER_DIRECTORY_ADMIN_ONLY=true
WEB_FRAME_PROTECTION_ENABLED=true
WEB_STRICT_CSP_ENABLED=true
