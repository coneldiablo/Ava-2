# Root-owned 0600 /etc/ava/onyx-native-knowledge/<deployment>.env.
# Replace all values with the reviewed release's actual absolute paths/UUID.
# The service write allowlist must match recipe and SQLite/WAL parent paths.
AVA_ONYX_CODE_DIRECTORY=/opt/ava-build/REVIEWED_RELEASE
AVA_ONYX_RECIPES_DIRECTORY=/opt/ava-module-recipes
AVA_CRM_DB_PATH=/run/ava-crm/ACTUAL_DATABASE_BASENAME
AVA_ONYX_DEPLOYMENT_ID=REVIEWED_DEPLOYMENT_UUID
