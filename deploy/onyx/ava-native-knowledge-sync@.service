[Unit]
Description=AVA private native knowledge catch-up for %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/ava/onyx-native-knowledge/%i.env
# Operator installs this template beside the immutable reviewed release.
# AVA_ONYX_CODE_DIRECTORY is a root-owned release directory, not request input.
ExecStart=/bin/sh -c 'exec /usr/bin/python3 "$${AVA_ONYX_CODE_DIRECTORY}/scripts/sync-onyx-native-knowledge.py" --run'
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Coordinator must supply BindPaths=<actual SQLite/WAL parent>:/run/ava-crm
# in a reviewed per-deployment drop-in. This exposes the same durable inode
# while ProtectHome hides the rest of /root. No database copy is permitted.
ReadWritePaths=/opt/ava-module-recipes /run/ava-crm
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
