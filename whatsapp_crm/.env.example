# ============ OPENWA MULTI-ACCOUNT GATEWAY ============
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_IMAGE_TAG=0.23.4
# Tag v0.23.4 is verified against immutable commit 1bfebfe57232bcb20ddd0975560d3f4bc994fb36 in Compose.
OPENWA_GIT_TAG=v0.23.4
OPENWA_LOG_LEVEL=info
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048

# ============ GREEN API CONFIGURATION (FALLBACK) ============
GREEN_API_URL=https://1103.api.green-api.com
ID_INSTANCE=your-green-api-instance-id
API_TOKEN_INSTANCE=your-green-api-token

# ============ AI CHAT CONFIGURATION (AITunnel) ============
AITUNNEL_API_URL=https://api.aitunnel.ru/v1
AITUNNEL_API_KEY=your-aitunnel-chat-api-key-here
AITUNNEL_MODEL=gpt-oss-120b

# ============ AI MESSAGE BATCHING ============
# Обычные сообщения: ждать паузу после последнего сообщения клиента
AI_BATCH_IDLE_MS=9000
# Короткие сообщения/приветствия/"да"/"ок": ждать дольше, чтобы клиент успел дописать мысль
AI_BATCH_SHORT_IDLE_MS=18000
# Максимальное ожидание одной пачки сообщений
AI_BATCH_MAX_MS=30000

# WhatsApp-specific batch window (does not change Telegram/VK timing)
WHATSAPP_BATCH_IDLE_MS=1500
WHATSAPP_BATCH_SHORT_IDLE_MS=3500
WHATSAPP_BATCH_MAX_MS=6000
WHATSAPP_ONYX_ANSWER_TIMEOUT_MS=3500

# Wait at most this long for a grounded Onyx answer before using same-business local RAG.
# Local retrieval starts at HEDGE_MS while Onyx is still running. Set WAIT_MS=65000
# to restore the original wait during a rollback (the Onyx HTTP timeout is 65s).
WHATSAPP_ONYX_WAIT_MS=6000
WHATSAPP_ONYX_HEDGE_MS=3000

# FALLBACK ВАРИАНТ: Ollama локальный (если оба облака не работают)
# Установи Ollama: https://ollama.ai
# Запусти модель: ollama pull gemma3:4b
# Останется в фоне на localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ============ GOOGLE CALENDAR (ОПЦИОНАЛЬНО) ============
GOOGLE_CALENDAR_CREDENTIALS_JSON={}
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# ============ SERVER CONFIGURATION ============
PORT=3000
NODE_ENV=development

# ============ CRM ADMIN AUTHENTICATION ============
AUTH_ENABLED=true
ADMIN_LOGIN=change-me
# Generate with: node -e "const c=require('crypto'),p='YOUR_PASSWORD',s=c.randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+c.scryptSync(p,s,64).toString('hex'))"
ADMIN_PASSWORD_HASH='scrypt$replace-salt$replace-hash'
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=24

# Internal AVA/Sales Brain API token for /api/ml/*
# Generate with: openssl rand -hex 32
CRM_SERVICE_API_TOKEN=
# AES-256-GCM key for tenant-scoped PMS credentials (32 bytes hex/base64).
PMS_CREDENTIALS_MASTER_KEY=
PMS_ENABLED=true
PUBLIC_BASE_URL=https://ava.example.com
BNOVO_API_BASE_URL=https://api.pms.bnovo.ru
# Separate encryption key for per-hotel Twenty API keys and webhook secrets.
TWENTY_CREDENTIALS_MASTER_KEY=
# Stable 32-byte key (64 hex chars or base64) for tenant channel credentials.
CHANNEL_CREDENTIALS_MASTER_KEY=
# Native v2.37.0 service-owner onboarding. Requires public HTTPS workspace routing.
TWENTY_PROVISIONING_BASE_URL=
TWENTY_PROVISIONING_EMAIL=
TWENTY_PROVISIONING_PASSWORD=
TWENTY_PROVISIONING_ROLE_LABEL=AVA Integration
# Customer access requires a separately deployed and accepted identity provider.
AVA_CUSTOMER_ACCESS_ENABLED=false
AVA_ISOLATED_MODULES_ENABLED=false
AVA_OIDC_ISSUER=https://auth.meludtech.tech/realms/ava
AVA_OIDC_CLIENT_ID=ava-web
AVA_OIDC_CLIENT_SECRET=
AVA_IDENTITY_BROKER_TOKEN=
# Worker-only: do not inject the following secret into the web process.
AVA_IDENTITY_ADMIN_CLIENT_ID=ava-enrollment-worker
AVA_IDENTITY_ADMIN_CLIENT_SECRET=
ONYX_CREDENTIALS_MASTER_KEY=
TWENTY_SYNC_ENABLED=true
CRM_MEMORY_ENABLED=false
CRM_MEMORY_BUSINESS_IDS=
TWENTY_SYNC_INTERVAL_MS=5000
TWENTY_RATE_LIMIT_PER_MINUTE=90
WHATSAPP_CRM_PUBLIC_URL=https://ava.example.com
AVA_PUBLIC_BASE_URL=https://ava.example.com
# AVA Admin internal API used to import/start Sales Brain outbound campaigns.
# Docker Compose value: http://admin_ui:3003
AVA_ADMIN_API_URL=http://127.0.0.1:3003
AVA_ADMIN_TIMEOUT_MS=15000

# ============ EMBEDDINGS (separate model/key from chat) ============
EMBEDDINGS_PROVIDER=aitunnel
EMBEDDINGS_API_URL=https://api.aitunnel.ru/v1
EMBEDDINGS_API_KEY=your-aitunnel-api-key-here
EMBEDDINGS_MODEL=gigachat-embeddings-giga-r
EMBEDDINGS_DIMENSIONS=0

# ============ COHERE RERANKER ============
COHERE_API_KEY=your-cohere-api-key-here
RERANKING_ENABLED=true

# ============ RAG CONFIGURATION ============
RAG_MIN_CONFIDENCE=0.3
HYDE_ENABLED=true
OCR_ENABLED=true

# ============ REDIS (for BullMQ + Embedding Cache) ============
REDIS_HOST=localhost
REDIS_PORT=6379
