FROM golang:1.22.10-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/Psiphon-Labs/psiphon-tunnel-core.git /src \
    && cd /src \
    && git checkout 4ba6e22a08f1

WORKDIR /src
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /ConsoleClient ./ConsoleClient

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /data psiphon

COPY --from=builder /ConsoleClient /usr/local/bin/ConsoleClient
COPY psiphon-client.config /etc/psiphon/client.config
COPY scripts/telegram-proxy-entrypoint.sh /usr/local/bin/telegram-proxy-entrypoint

RUN chmod 0755 /usr/local/bin/telegram-proxy-entrypoint

EXPOSE 8086

HEALTHCHECK --interval=10s --timeout=15s --start-period=45s --retries=12 \
    CMD curl --fail --silent --show-error --socks5-hostname 127.0.0.1:8086 https://api.telegram.org/ > /dev/null || exit 1

ENTRYPOINT ["telegram-proxy-entrypoint"]
CMD ["ConsoleClient", "-config", "/etc/psiphon/client.config"]
