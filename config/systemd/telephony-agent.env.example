# Host only. Install as /etc/ava/telephony-agent.env, root:root 0600.
# Generate tokens outside the repository; never paste them into evidence.
AVA_TELEPHONY_AGENT_TOKEN=
CRM_SERVICE_API_TOKEN=
AVA_TELEPHONY_CRM_URL=http://127.0.0.1:3001
AVA_TELEPHONY_AGENT_SOCKET=/run/ava-telephony/agent.sock
AVA_TELEPHONY_CONFIG_DIR=/etc/asterisk/ava-managed
AVA_ASTERISK_BIN=/usr/sbin/asterisk
AVA_TELEPHONY_TRANSPORT=transport-udp
# Verify the provider-returned domain and registration mode before extending this allowlist.
AVA_TELEPHONY_SIP_DOMAINS=sip.exolve.ru
# Existing trusted shared inbound endpoint, discovered from live read-only config.
AVA_TELEPHONY_EXOLVE_ENDPOINT=
AVA_TELEPHONY_RESOLVER_PORT=8097
# Enable only after includes, ingress context and legacy mappings are verified.
AVA_TELEPHONY_INGRESS_VERIFIED=false
