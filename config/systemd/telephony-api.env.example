# Public CRM process. No provider key, vault key, agent token or host socket mount.
AVA_TELEPHONY_WORKER_ENABLED=false
AVA_TELEPHONY_PURCHASE_ENABLED=false
AVA_TELEPHONY_PILOT_BUSINESSES=
AVA_TELEPHONY_OUTBOUND_ENABLED=false
# Non-secret identity also required in API because it persists application scope on orders.
EXOLVE_APPLICATION_UUID=
# Explicit operator-verified DID -> integer business ID only. Empty by default.
AVA_TELEPHONY_LEGACY_DIDS={}
# Existing machine token, supplied securely to CRM, engine and host resolver.
CRM_SERVICE_API_TOKEN=
