# Dedicated provisioning worker ONLY; merge with its existing identity/Onyx/Twenty config.
# Do not feed this file to public CRM, engine, frontend build or docker build args.
AVA_PROCESS_ROLE=provisioning-worker
AVA_PROVISIONING_JOBS_ENABLED=true
AVA_TELEPHONY_WORKER_ENABLED=false
AVA_TELEPHONY_PURCHASE_ENABLED=false
AVA_TELEPHONY_PILOT_BUSINESSES=
AVA_TELEPHONY_OUTBOUND_ENABLED=false
EXOLVE_APPLICATION_UUID=
EXOLVE_API_KEY=
# Exactly 64 hexadecimal characters, independent of the agent token.
AVA_TELEPHONY_MASTER_KEY=
# Worker mount: parent directory, read-only; add the host asterisk numeric GID.
AVA_TELEPHONY_AGENT_SOCKET=/run/ava-telephony/agent.sock
AVA_TELEPHONY_AGENT_TOKEN=
EXOLVE_STATIC_IP=
EXOLVE_STATIC_PORT=5060
DB_PATH=/app/data/crm_v2.db
